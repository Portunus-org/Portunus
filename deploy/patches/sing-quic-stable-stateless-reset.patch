@@ -0,0 +1,39 @@
+package qtls
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"os"
+
+	"github.com/sagernet/quic-go"
+)
+
+// statelessResetKey returns the key used to derive QUIC stateless reset
+// tokens. By default it is random per listener, so after a restart the new
+// instance cannot produce resets that clients accept, and clients wait for
+// their idle timeout before reconnecting. Setting
+// SING_QUIC_STATELESS_RESET_KEY (64 hex characters, kept secret) keeps the
+// key stable across restarts: clients of a reloaded server are reset at once
+// and reconnect immediately.
+//
+// With the key set, listeners created without explicit options (TUIC) send
+// stateless resets too. Callers that disable them on purpose (Hysteria2 with
+// obfuscation, which must stay silent to unknown packets) are unaffected.
+func statelessResetKeyConfigured() bool {
+	return os.Getenv("SING_QUIC_STATELESS_RESET_KEY") != ""
+}
+
+func statelessResetKey() (*quic.StatelessResetKey, error) {
+	key := new(quic.StatelessResetKey)
+	if v := os.Getenv("SING_QUIC_STATELESS_RESET_KEY"); v != "" {
+		b, err := hex.DecodeString(v)
+		if err != nil || len(b) != len(key) {
+			return nil, errors.New("SING_QUIC_STATELESS_RESET_KEY: want 64 hex characters")
+		}
+		copy(key[:], b)
+		return key, nil
+	}
+	_, err := rand.Read(key[:])
+	return key, err
+}
