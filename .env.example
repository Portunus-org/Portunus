# Optional settings of the panel, with their defaults. None is required.
# To use them, either copy the lines you need into an `environment:` block of
# the service in docker-compose.yml, or copy this file to .env and add
# `env_file: .env` to the service.
# Full reference: docs/DEPLOY.md

# Panel HTTP address. Keep it on loopback and use an SSH tunnel:
#   ssh -N -L 2053:127.0.0.1:2053 user@server
PORTUNUS_LISTEN=127.0.0.1:2053

# debug | info | warn | error
PORTUNUS_LOG_LEVEL=info

# json | text
PORTUNUS_LOG_FORMAT=json

# Session cookie Secure flag: auto (when served over TLS) | always | never
PORTUNUS_COOKIE_SECURE=auto

# Optional public listener that serves only client subscriptions (/sub/...).
# Example: 0.0.0.0:2096. Then set "Subscription URL" in the panel's settings.
# Empty: subscriptions are not published; clients import individual links.
PORTUNUS_SUB_LISTEN=

# Container image the join command for new nodes uses. By default it is the
# published node image of the panel's own version
# (ghcr.io/paulichp/portunus-node:<version>), so joining is one command. Set
# it for a registry of your own, or to a name without a registry for a local
# build (docker build --target node -t portunus-node:local -f deploy/Dockerfile .):
# the panel then also shows how to copy the image to the new server.
# PORTUNUS_NODE_IMAGE=portunus-node:local

# Where servers are on the map of nodes is looked up by address through this
# service (the panel requests <URL><IP> for its own address and each node's).
# "off" disables the lookup; servers can still be placed on the map by hand.
# PORTUNUS_GEO_LOOKUP=https://ipwho.is/

# Map images for the map of nodes are fetched by the panel from this tile
# server (template with {z}, {x}, {y}, optionally {style} = light|dark),
# cached, and passed on to the browser. "off" shows plain country outlines.
# PORTUNUS_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
